{
  "$comment": "Turkish terminology for CyberForge. `terms` is the translator reference (docs/localization.md); `avoid` is enforced by catalogue.test.ts against every Turkish string in the app.",
  "terms": [
    {
      "en": "agent (AI)",
      "tr": "ajan",
      "note": "\"aracı\" means intermediary and is only correct as the accusative of \"araç\" (tool)"
    },
    { "en": "alert", "tr": "uyarı" },
    { "en": "allow-list", "tr": "izin listesi" },
    { "en": "attacker / intruder", "tr": "saldırgan" },
    { "en": "blast radius", "tr": "etki alanı" },
    { "en": "bastion host", "tr": "bastion sunucusu" },
    { "en": "bucket (storage)", "tr": "depolama kovası" },
    { "en": "canary token", "tr": "kanarya belirteci" },
    { "en": "case", "tr": "vaka" },
    { "en": "container", "tr": "konteyner" },
    { "en": "containment", "tr": "sınırlama" },
    { "en": "credential", "tr": "kimlik bilgisi" },
    { "en": "cyber range", "tr": "siber tatbikat alanı" },
    { "en": "detection", "tr": "tespit" },
    { "en": "download cradle", "tr": "download cradle", "note": "term of art, left in English" },
    { "en": "event / incident", "tr": "olay" },
    { "en": "false positive", "tr": "yanlış pozitif" },
    { "en": "hardening", "tr": "sıkılaştırma" },
    { "en": "host", "tr": "ana bilgisayar" },
    { "en": "instance (of the app)", "tr": "kurulum", "note": "\"örnek\" means sample" },
    { "en": "investigation", "tr": "inceleme" },
    { "en": "lab", "tr": "laboratuvar" },
    { "en": "log", "tr": "günlük" },
    { "en": "mitigation", "tr": "önlem" },
    { "en": "password", "tr": "parola" },
    { "en": "password spraying", "tr": "parola püskürtme" },
    { "en": "persistence", "tr": "kalıcılık" },
    { "en": "playground", "tr": "deneme alanı" },
    { "en": "port", "tr": "port" },
    { "en": "process", "tr": "işlem" },
    { "en": "prompt", "tr": "istem" },
    { "en": "prompt injection", "tr": "istem enjeksiyonu" },
    { "en": "remediation", "tr": "giderme" },
    { "en": "script", "tr": "betik" },
    { "en": "secret", "tr": "gizli bilgi" },
    { "en": "seeded (data)", "tr": "hazır" },
    { "en": "severity", "tr": "önem derecesi", "note": "\"Önem\" only as a narrow column heading" },
    { "en": "ticket", "tr": "talep", "note": "Kerberos tickets are \"bilet\"" },
    { "en": "token", "tr": "belirteç" },
    { "en": "triage", "tr": "önceliklendirme" },
    { "en": "web shell", "tr": "web kabuğu" }
  ],
  "avoid": [
    { "pattern": "laboratuar", "use": "laboratuvar" },
    { "pattern": "hızlı (enjeksiyon|ekleme)", "use": "istem enjeksiyonu" },
    {
      "pattern": "\\bbilet",
      "use": "talep",
      "allow": ["Kerberos", "önbelleğe alınmış biletler", "özetleri ve biletleri"]
    },
    { "pattern": "kapsayıcı", "use": "konteyner" },
    { "pattern": "\\bjeton", "use": "belirteç" },
    { "pattern": "muhafaza", "use": "sınırlama" },
    { "pattern": "davetsiz misafir", "use": "saldırgan" },
    { "pattern": "ana makine", "use": "ana bilgisayar" },
    { "pattern": "beşik", "use": "download cradle" },
    { "pattern": "tohumlan", "use": "hazır" },
    { "pattern": "bağlantı noktası", "use": "port" },
    { "pattern": "\\bharic[iî]", "use": "dış" },
    { "pattern": "oyun alanı", "use": "deneme alanı" },
    { "pattern": "hafifletici|hafifletme", "use": "önlem" },
    { "pattern": "\\bsprey", "use": "püskürtme" },
    { "pattern": "ilaçlama", "use": "püskürtme" },
    { "pattern": "\\bajans", "use": "ajan" },
    { "pattern": "\\bkale(ye|de|nin|si)?\\b", "use": "bastion" },
    { "pattern": "triyaj", "use": "önceliklendirme" },
    { "pattern": "sağlamlaştır|sertleşt", "use": "sıkılaştır" },
    { "pattern": "\\balgılama", "use": "tespit" },
    { "pattern": "uzlaş", "use": "ele geçir" },
    { "pattern": "\\b[Şş]ifre(?!le)", "use": "parola" },
    { "pattern": "web kabuk(?!ğ|lar)", "use": "web kabuğu" },
    { "pattern": "\\bsır(lar|ları|ı|rı)?\\b", "use": "gizli bilgi" },
    { "pattern": "\\bbu örne(k|ğ)\\w*", "use": "bu kurulum" }
  ]
}
