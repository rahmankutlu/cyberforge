{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by scripts/export_schemas.py. Describes detections/sigma/**/<slug>.tests.yml.",
  "$defs": {
    "RuleTestCase": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 120,
          "minLength": 3,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "event": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A single event as flat fields",
          "title": "Event"
        },
        "events": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/RuleTestEvent"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Events"
        },
        "category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Default telemetry category for the events; omit to use the rule's own",
          "title": "Category"
        },
        "expected": {
          "description": "True if the rule must fire, false if it must stay quiet",
          "title": "Expected",
          "type": "boolean"
        },
        "matches": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Exact 0-based indexes of the events that must match (single-event rules)",
          "title": "Matches"
        },
        "hits": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Exact number of correlation hits (correlation rules)",
          "title": "Hits"
        }
      },
      "required": [
        "name",
        "expected"
      ],
      "title": "RuleTestCase",
      "type": "object"
    },
    "RuleTestEvent": {
      "additionalProperties": false,
      "description": "One event (or a burst of them, via `repeat`/`every`) inside a multi-event test case.\n\n`{i}`, `{i+N}` and `{i*N}` inside string values are replaced by the repeat index, exactly as in\nlab scenarios.",
      "properties": {
        "t": {
          "default": 0,
          "description": "Seconds from the start of the case",
          "minimum": 0,
          "title": "T",
          "type": "number"
        },
        "repeat": {
          "default": 1,
          "maximum": 500,
          "minimum": 1,
          "title": "Repeat",
          "type": "integer"
        },
        "every": {
          "default": 1.0,
          "description": "Seconds between repeats",
          "minimum": 0,
          "title": "Every",
          "type": "number"
        },
        "category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Telemetry category; picks the logsource",
          "title": "Category"
        },
        "logsource": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "string"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Logsource"
        },
        "fields": {
          "additionalProperties": true,
          "title": "Fields",
          "type": "object"
        }
      },
      "title": "RuleTestEvent",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "tests": {
      "items": {
        "$ref": "#/$defs/RuleTestCase"
      },
      "minItems": 1,
      "title": "Tests",
      "type": "array"
    }
  },
  "required": [
    "tests"
  ],
  "title": "RuleTestFile",
  "type": "object"
}
