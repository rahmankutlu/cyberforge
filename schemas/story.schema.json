{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by scripts/export_schemas.py. Describes stories/<slug>.yaml.",
  "$defs": {
    "ChainLink": {
      "additionalProperties": false,
      "properties": {
        "tactic": {
          "description": "Tactic name, e.g. Execution",
          "minLength": 3,
          "title": "Tactic",
          "type": "string"
        },
        "technique": {
          "title": "Technique",
          "type": "string"
        },
        "step": {
          "description": "Id of the step where it happens",
          "title": "Step",
          "type": "string"
        },
        "description": {
          "description": "What the attacker did, in one sentence",
          "minLength": 10,
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "tactic",
        "technique",
        "step",
        "description"
      ],
      "title": "ChainLink",
      "type": "object"
    },
    "ContainmentOption": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "action": {
          "maxLength": 120,
          "minLength": 5,
          "title": "Action",
          "type": "string"
        },
        "category": {
          "enum": [
            "isolate",
            "credentials",
            "block",
            "eradicate",
            "monitor",
            "communicate",
            "other"
          ],
          "title": "Category",
          "type": "string"
        },
        "quality": {
          "enum": [
            "recommended",
            "optional",
            "harmful"
          ],
          "title": "Quality",
          "type": "string"
        },
        "effect": {
          "description": "What this action achieves, or costs",
          "minLength": 10,
          "title": "Effect",
          "type": "string"
        },
        "feedback": {
          "description": "Shown after the analyst submits",
          "minLength": 10,
          "title": "Feedback",
          "type": "string"
        }
      },
      "required": [
        "id",
        "action",
        "category",
        "quality",
        "effect",
        "feedback"
      ],
      "title": "ContainmentOption",
      "type": "object"
    },
    "Decision": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "prompt": {
          "minLength": 10,
          "title": "Prompt",
          "type": "string"
        },
        "context": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/DecisionOption"
          },
          "maxItems": 5,
          "minItems": 2,
          "title": "Options",
          "type": "array"
        }
      },
      "required": [
        "id",
        "prompt",
        "options"
      ],
      "title": "Decision",
      "type": "object"
    },
    "DecisionOption": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "text": {
          "minLength": 3,
          "title": "Text",
          "type": "string"
        },
        "quality": {
          "enum": [
            "best",
            "acceptable",
            "poor"
          ],
          "title": "Quality",
          "type": "string"
        },
        "feedback": {
          "minLength": 10,
          "title": "Feedback",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text",
        "quality",
        "feedback"
      ],
      "title": "DecisionOption",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Unique within the story",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 100,
          "minLength": 3,
          "title": "Title",
          "type": "string"
        },
        "kind": {
          "default": "log",
          "enum": [
            "log",
            "process-tree",
            "network",
            "email",
            "ticket",
            "note",
            "alert"
          ],
          "title": "Kind",
          "type": "string"
        },
        "content": {
          "description": "Shown verbatim in a code block",
          "minLength": 3,
          "title": "Content",
          "type": "string"
        },
        "significance": {
          "default": "supporting",
          "enum": [
            "key",
            "supporting",
            "noise"
          ],
          "title": "Significance",
          "type": "string"
        },
        "finding": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Why this matters. Shown when the analyst marks it as a finding.",
          "title": "Finding"
        }
      },
      "required": [
        "id",
        "title",
        "content"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "GraphEdge": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "relation": {
          "enum": [
            "executed",
            "connected to",
            "triggered",
            "mapped to",
            "associated with"
          ],
          "title": "Relation",
          "type": "string"
        }
      },
      "required": [
        "source",
        "target",
        "relation"
      ],
      "title": "GraphEdge",
      "type": "object"
    },
    "GraphNode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "user",
            "host",
            "process",
            "ip",
            "domain",
            "detection",
            "alert",
            "technique"
          ],
          "title": "Type",
          "type": "string"
        },
        "label": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "detection: rule slug. technique: MITRE id. Others: not used.",
          "title": "Ref"
        }
      },
      "required": [
        "id",
        "type",
        "label"
      ],
      "title": "GraphNode",
      "type": "object"
    },
    "Postmortem": {
      "additionalProperties": false,
      "properties": {
        "summary": {
          "minLength": 40,
          "title": "Summary",
          "type": "string"
        },
        "root_cause": {
          "minLength": 20,
          "title": "Root Cause",
          "type": "string"
        },
        "what_worked": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "What Worked",
          "type": "array"
        },
        "what_to_improve": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "What To Improve",
          "type": "array"
        },
        "detections_to_add": {
          "items": {
            "type": "string"
          },
          "title": "Detections To Add",
          "type": "array"
        },
        "lessons": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Lessons",
          "type": "array"
        }
      },
      "required": [
        "summary",
        "root_cause",
        "what_worked",
        "what_to_improve",
        "lessons"
      ],
      "title": "Postmortem",
      "type": "object"
    },
    "Question": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "prompt": {
          "minLength": 10,
          "title": "Prompt",
          "type": "string"
        },
        "kind": {
          "default": "single",
          "enum": [
            "single",
            "multiple"
          ],
          "title": "Kind",
          "type": "string"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/QuestionOption"
          },
          "maxItems": 8,
          "minItems": 2,
          "title": "Options",
          "type": "array"
        },
        "hint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hint"
        }
      },
      "required": [
        "id",
        "prompt",
        "options"
      ],
      "title": "Question",
      "type": "object"
    },
    "QuestionOption": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "text": {
          "minLength": 2,
          "title": "Text",
          "type": "string"
        },
        "correct": {
          "default": false,
          "title": "Correct",
          "type": "boolean"
        },
        "explanation": {
          "description": "Shown after the analyst answers",
          "minLength": 5,
          "title": "Explanation",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text",
        "explanation"
      ],
      "title": "QuestionOption",
      "type": "object"
    },
    "ScenarioEvent": {
      "additionalProperties": false,
      "description": "One telemetry event in a lab scenario or dataset. `t` is seconds from scenario start.\n\n`repeat`/`every` expand one line into a burst. Inside string values, `{i}` is the 0-based\nrepeat index; `{i+N}` and `{i*N}` do simple arithmetic (a value that is only a placeholder\nbecomes an integer).",
      "properties": {
        "t": {
          "minimum": 0,
          "title": "T",
          "type": "number"
        },
        "repeat": {
          "default": 1,
          "maximum": 500,
          "minimum": 1,
          "title": "Repeat",
          "type": "integer"
        },
        "every": {
          "default": 1.0,
          "minimum": 0,
          "title": "Every",
          "type": "number"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "host": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Host"
        },
        "user": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User"
        },
        "action": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action"
        },
        "outcome": {
          "anyOf": [
            {
              "enum": [
                "success",
                "failure",
                "blocked",
                "allowed",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outcome"
        },
        "fields": {
          "additionalProperties": true,
          "title": "Fields",
          "type": "object"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Human explanation shown in the lifecycle view",
          "title": "Note"
        }
      },
      "required": [
        "t",
        "category"
      ],
      "title": "ScenarioEvent",
      "type": "object"
    },
    "Step": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "time": {
          "description": "Clock time HH:MM. Telemetry offsets are relative to it.",
          "title": "Time",
          "type": "string"
        },
        "title": {
          "maxLength": 80,
          "minLength": 3,
          "title": "Title",
          "type": "string"
        },
        "narrative": {
          "description": "What the analyst sees at this point",
          "minLength": 20,
          "title": "Narrative",
          "type": "string"
        },
        "telemetry": {
          "items": {
            "$ref": "#/$defs/ScenarioEvent"
          },
          "minItems": 1,
          "title": "Telemetry",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "detections": {
          "description": "Slugs of the rules that fire on this step's telemetry",
          "items": {
            "type": "string"
          },
          "title": "Detections",
          "type": "array"
        },
        "alert": {
          "anyOf": [
            {
              "$ref": "#/$defs/StepAlert"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "techniques": {
          "items": {
            "type": "string"
          },
          "title": "Techniques",
          "type": "array"
        },
        "questions": {
          "items": {
            "$ref": "#/$defs/Question"
          },
          "title": "Questions",
          "type": "array"
        },
        "decision": {
          "anyOf": [
            {
              "$ref": "#/$defs/Decision"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "graph_nodes": {
          "items": {
            "$ref": "#/$defs/GraphNode"
          },
          "title": "Graph Nodes",
          "type": "array"
        },
        "graph_edges": {
          "items": {
            "$ref": "#/$defs/GraphEdge"
          },
          "title": "Graph Edges",
          "type": "array"
        }
      },
      "required": [
        "id",
        "time",
        "title",
        "narrative",
        "telemetry",
        "evidence"
      ],
      "title": "Step",
      "type": "object"
    },
    "StepAlert": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "minLength": 5,
          "title": "Title",
          "type": "string"
        },
        "severity": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "informational"
          ],
          "title": "Severity",
          "type": "string"
        },
        "rule": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Slug of the rule that raised it",
          "title": "Rule"
        }
      },
      "required": [
        "title",
        "severity"
      ],
      "title": "StepAlert",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "slug": {
      "maxLength": 96,
      "minLength": 3,
      "title": "Slug",
      "type": "string"
    },
    "title": {
      "maxLength": 80,
      "minLength": 5,
      "title": "Title",
      "type": "string"
    },
    "summary": {
      "maxLength": 320,
      "minLength": 40,
      "title": "Summary",
      "type": "string"
    },
    "difficulty": {
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ],
      "title": "Difficulty",
      "type": "string"
    },
    "duration_minutes": {
      "maximum": 120,
      "minimum": 5,
      "title": "Duration Minutes",
      "type": "integer"
    },
    "domain": {
      "enum": [
        "endpoint",
        "identity",
        "web",
        "network",
        "cloud",
        "ai-security"
      ],
      "title": "Domain",
      "type": "string"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "order": {
      "default": 100,
      "description": "Position in the story list",
      "maximum": 999,
      "minimum": 1,
      "title": "Order",
      "type": "integer"
    },
    "briefing": {
      "description": "The ticket the analyst starts from",
      "minLength": 60,
      "title": "Briefing",
      "type": "string"
    },
    "attack_chain": {
      "items": {
        "$ref": "#/$defs/ChainLink"
      },
      "minItems": 3,
      "title": "Attack Chain",
      "type": "array"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/Step"
      },
      "maxItems": 12,
      "minItems": 4,
      "title": "Steps",
      "type": "array"
    },
    "containment": {
      "items": {
        "$ref": "#/$defs/ContainmentOption"
      },
      "maxItems": 10,
      "minItems": 4,
      "title": "Containment",
      "type": "array"
    },
    "postmortem": {
      "$ref": "#/$defs/Postmortem"
    }
  },
  "required": [
    "slug",
    "title",
    "summary",
    "difficulty",
    "duration_minutes",
    "domain",
    "briefing",
    "attack_chain",
    "steps",
    "containment",
    "postmortem"
  ],
  "title": "StoryDoc",
  "type": "object"
}
