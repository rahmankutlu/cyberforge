# CyberForge lab rules for Suricata. Educational detections for the isolated lab network.
# sid range 9000000-9000099 is reserved for CyberForge. Load with: suricata -S cyberforge-lab.rules
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"CF LAB Possible TCP SYN Scan - many probes from one source"; flags:S; threshold:type both, track by_src, count 20, seconds 10; classtype:attempted-recon; sid:9000001; rev:1; metadata:mitre_technique_id T1046, severity medium;)
alert http any any -> $HOME_NET any (msg:"CF LAB Known Scanner User-Agent sqlmap"; flow:established,to_server; http.user_agent; content:"sqlmap"; nocase; classtype:web-application-attack; sid:9000002; rev:1; metadata:mitre_technique_id T1595.002, severity low;)
alert dns $HOME_NET any -> any any (msg:"CF LAB DNS Query With Long Encoded Label"; dns.query; pcre:"/^[a-z0-9+\/=_-]{30,}\./i"; classtype:bad-unknown; sid:9000003; rev:1; metadata:mitre_technique_id T1071.004, severity high;)
alert http any any -> $HOME_NET any (msg:"CF LAB Request For Exposed Environment File"; flow:established,to_server; http.uri; content:"/.env"; endswith; classtype:web-application-attack; sid:9000004; rev:1; metadata:mitre_technique_id T1552.001, severity medium;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"CF LAB Canary Token In Outbound HTTP Body"; flow:established,to_server; http.request_body; content:"CF-CANARY-"; classtype:policy-violation; sid:9000005; rev:1; metadata:mitre_technique_id T1048, severity critical;)
