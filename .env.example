# CyberForge configuration. Copy to `.env` and adjust:  cp .env.example .env
#
# The defaults are for LOCAL development only. In production mode (CYBERFORGE_ENV=production) the
# API refuses to start with the placeholder passwords and tokens below, or with wildcard CORS.

# ── General ───────────────────────────────────────────────────────────────────────────────────
CYBERFORGE_ENV=development             # development | test | production
CYBERFORGE_DEMO_MODE=true              # seed and generate synthetic telemetry, alerts and incidents
CYBERFORGE_SEED_ON_START=true          # populate an empty database on first start

# ── Ports (always bound to 127.0.0.1) ─────────────────────────────────────────────────────────
WEB_PORT=3000
API_PORT=8000
LAB_GATEWAY_PORT=8081                  # only with: docker compose --profile labs up

# ── PostgreSQL ────────────────────────────────────────────────────────────────────────────────
POSTGRES_USER=cyberforge
POSTGRES_DB=cyberforge
# Use URL-safe characters only (it is embedded in DATABASE_URL). Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=cyberforge_local_dev

# ── Security ──────────────────────────────────────────────────────────────────────────────────
# Origins allowed to make state-changing browser requests to the API (comma separated, no wildcard).
# Same-origin requests through the web app's /api/v1 proxy work regardless.
CYBERFORGE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Shared secret the lab containers use to ship telemetry to the API. Generate one with: openssl rand -hex 24
CYBERFORGE_LAB_INGEST_TOKEN=cyberforge-lab-token

# ── Optional AI analyst (leave CYBERFORGE_AI_PROVIDER=none to disable) ──────────────────────────────
# Nothing is sent to a provider unless you click "Analyze with AI" on an alert.
CYBERFORGE_AI_PROVIDER=none            # none | openai (any OpenAI-compatible API) | gemini | ollama
CYBERFORGE_AI_MODEL=                   # e.g. a model id from your provider; for ollama, a local model name
CYBERFORGE_AI_API_KEY=                 # not needed for ollama or a local OpenAI-compatible server
CYBERFORGE_AI_BASE_URL=                # optional override, e.g. http://host.docker.internal:11434 for Ollama
