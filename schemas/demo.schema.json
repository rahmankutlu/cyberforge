{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by scripts/export_schemas.py. Describes demos/<slug>.yaml.",
  "$defs": {
    "DemoContainment": {
      "additionalProperties": false,
      "properties": {
        "t": {
          "minimum": 0,
          "title": "T",
          "type": "number"
        },
        "state": {
          "enum": [
            "monitoring",
            "containing",
            "contained"
          ],
          "title": "State",
          "type": "string"
        },
        "label": {
          "minLength": 3,
          "title": "Label",
          "type": "string"
        },
        "detail": {
          "minLength": 10,
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "t",
        "state",
        "label",
        "detail"
      ],
      "title": "DemoContainment",
      "type": "object"
    },
    "DemoNote": {
      "additionalProperties": false,
      "properties": {
        "t": {
          "minimum": 0,
          "title": "T",
          "type": "number"
        },
        "analyst": {
          "minLength": 2,
          "title": "Analyst",
          "type": "string"
        },
        "body": {
          "minLength": 20,
          "title": "Body",
          "type": "string"
        }
      },
      "required": [
        "t",
        "analyst",
        "body"
      ],
      "title": "DemoNote",
      "type": "object"
    },
    "ScenarioEvent": {
      "additionalProperties": false,
      "description": "One telemetry event in a lab scenario or dataset. `t` is seconds from scenario start.\n\n`repeat`/`every` expand one line into a burst. Inside string values, `{i}` is the 0-based\nrepeat index; `{i+N}` and `{i*N}` do simple arithmetic (a value that is only a placeholder\nbecomes an integer).",
      "properties": {
        "t": {
          "minimum": 0,
          "title": "T",
          "type": "number"
        },
        "repeat": {
          "default": 1,
          "maximum": 500,
          "minimum": 1,
          "title": "Repeat",
          "type": "integer"
        },
        "every": {
          "default": 1.0,
          "minimum": 0,
          "title": "Every",
          "type": "number"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "host": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Host"
        },
        "user": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User"
        },
        "action": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action"
        },
        "outcome": {
          "anyOf": [
            {
              "enum": [
                "success",
                "failure",
                "blocked",
                "allowed",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outcome"
        },
        "fields": {
          "additionalProperties": true,
          "title": "Fields",
          "type": "object"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Human explanation shown in the lifecycle view",
          "title": "Note"
        }
      },
      "required": [
        "t",
        "category"
      ],
      "title": "ScenarioEvent",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "slug": {
      "maxLength": 96,
      "minLength": 3,
      "title": "Slug",
      "type": "string"
    },
    "title": {
      "maxLength": 80,
      "minLength": 5,
      "title": "Title",
      "type": "string"
    },
    "summary": {
      "maxLength": 400,
      "minLength": 40,
      "title": "Summary",
      "type": "string"
    },
    "duration_seconds": {
      "maximum": 300,
      "minimum": 30,
      "title": "Duration Seconds",
      "type": "integer"
    },
    "start_clock": {
      "description": "Wall-clock time the scenario starts, HH:MM:SS",
      "title": "Start Clock",
      "type": "string"
    },
    "host": {
      "description": "The host the incident is about",
      "title": "Host",
      "type": "string"
    },
    "user": {
      "title": "User",
      "type": "string"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/ScenarioEvent"
      },
      "minItems": 6,
      "title": "Events",
      "type": "array"
    },
    "notes": {
      "items": {
        "$ref": "#/$defs/DemoNote"
      },
      "title": "Notes",
      "type": "array"
    },
    "containment": {
      "items": {
        "$ref": "#/$defs/DemoContainment"
      },
      "minItems": 2,
      "title": "Containment",
      "type": "array"
    }
  },
  "required": [
    "slug",
    "title",
    "summary",
    "duration_seconds",
    "start_clock",
    "host",
    "user",
    "events",
    "containment"
  ],
  "title": "DemoScenario",
  "type": "object"
}
