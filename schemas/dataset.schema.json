{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by scripts/export_schemas.py. Describes datasets/playground/<slug>.yaml.",
  "$defs": {
    "SampleFile": {
      "additionalProperties": false,
      "description": "A synthetic file for YARA. `content` may be split into parts and is joined on load.\n\nSplitting keeps antivirus products on contributors' machines from quarantining well-known test\nstrings (such as the EICAR file) inside the repository. `hex_prefix` prepends raw bytes, for\nrules that check magic numbers.",
      "properties": {
        "name": {
          "maxLength": 80,
          "minLength": 3,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "minLength": 10,
          "title": "Description",
          "type": "string"
        },
        "content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "default": "",
          "title": "Content"
        },
        "hex_prefix": {
          "anyOf": [
            {
              "pattern": "^(?:[0-9A-Fa-f]{2})+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hex Prefix"
        }
      },
      "required": [
        "name",
        "description"
      ],
      "title": "SampleFile",
      "type": "object"
    },
    "ScenarioEvent": {
      "additionalProperties": false,
      "description": "One telemetry event in a lab scenario or dataset. `t` is seconds from scenario start.\n\n`repeat`/`every` expand one line into a burst. Inside string values, `{i}` is the 0-based\nrepeat index; `{i+N}` and `{i*N}` do simple arithmetic (a value that is only a placeholder\nbecomes an integer).",
      "properties": {
        "t": {
          "minimum": 0,
          "title": "T",
          "type": "number"
        },
        "repeat": {
          "default": 1,
          "maximum": 500,
          "minimum": 1,
          "title": "Repeat",
          "type": "integer"
        },
        "every": {
          "default": 1.0,
          "minimum": 0,
          "title": "Every",
          "type": "number"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "host": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Host"
        },
        "user": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User"
        },
        "action": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action"
        },
        "outcome": {
          "anyOf": [
            {
              "enum": [
                "success",
                "failure",
                "blocked",
                "allowed",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outcome"
        },
        "fields": {
          "additionalProperties": true,
          "title": "Fields",
          "type": "object"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Human explanation shown in the lifecycle view",
          "title": "Note"
        }
      },
      "required": [
        "t",
        "category"
      ],
      "title": "ScenarioEvent",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A curated, synthetic dataset for the detection playground.\n\n`expected_rules` is a contract, checked in CI: every listed rule must fire on the dataset.\nOther rules may fire too; the playground shows them as \"also matched\".",
  "properties": {
    "slug": {
      "maxLength": 96,
      "minLength": 3,
      "title": "Slug",
      "type": "string"
    },
    "name": {
      "maxLength": 80,
      "minLength": 3,
      "title": "Name",
      "type": "string"
    },
    "description": {
      "minLength": 30,
      "title": "Description",
      "type": "string"
    },
    "source_type": {
      "description": "What produced these logs, e.g. Sysmon EID 1",
      "minLength": 3,
      "title": "Source Type",
      "type": "string"
    },
    "kind": {
      "default": "events",
      "enum": [
        "events",
        "files"
      ],
      "title": "Kind",
      "type": "string"
    },
    "difficulty": {
      "default": "beginner",
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ],
      "title": "Difficulty",
      "type": "string"
    },
    "mitre": {
      "items": {
        "type": "string"
      },
      "title": "Mitre",
      "type": "array"
    },
    "expected_rules": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Expected Rules",
      "type": "array"
    },
    "try_this": {
      "description": "Suggested things to try",
      "items": {
        "type": "string"
      },
      "title": "Try This",
      "type": "array"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/ScenarioEvent"
      },
      "title": "Events",
      "type": "array"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/SampleFile"
      },
      "title": "Files",
      "type": "array"
    }
  },
  "required": [
    "slug",
    "name",
    "description",
    "source_type",
    "expected_rules"
  ],
  "title": "PlaygroundDataset",
  "type": "object"
}
