{
  "name": "cyberforge",
  "version": "0.2.0",
  "private": true,
  "description": "CyberForge: The Open Cybersecurity Lab. Learn. Simulate. Detect. Investigate. Defend.",
  "license": "MIT",
  "author": "Abdurrahman Kutlu",
  "homepage": "https://github.com/rahmankutlu/cyberforge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rahmankutlu/cyberforge.git"
  },
  "bugs": {
    "url": "https://github.com/rahmankutlu/cyberforge/issues"
  },
  "keywords": [
    "cybersecurity",
    "soc",
    "blue-team",
    "detection-engineering",
    "sigma",
    "yara",
    "suricata",
    "mitre-attack",
    "cyber-range"
  ],
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "pnpm --filter @cyberforge/web dev",
    "dev:api": "node scripts/dev-api.mjs",
    "build": "pnpm --filter @cyberforge/web build",
    "lint": "pnpm -r --if-present lint && pnpm lint:api",
    "lint:api": "node scripts/py.mjs -m ruff check apps/api scripts labs",
    "typecheck": "pnpm -r --if-present typecheck",
    "typecheck:api": "node scripts/py.mjs -m mypy --config-file apps/api/pyproject.toml apps/api/cyberforge",
    "test": "pnpm test:web && pnpm test:api",
    "test:web": "pnpm --filter @cyberforge/web test",
    "test:api": "node scripts/py.mjs -m pytest apps/api -q",
    "test:e2e": "pnpm --filter @cyberforge/web e2e",
    "validate:content": "node scripts/py.mjs scripts/validate_content.py",
    "cyberforge": "node scripts/py.mjs -m cyberforge",
    "test:detections": "node scripts/py.mjs -m cyberforge detections test --require-tests",
    "create:lab": "node scripts/py.mjs -m cyberforge lab create",
    "schemas": "node scripts/py.mjs scripts/export_schemas.py",
    "schemas:check": "node scripts/py.mjs scripts/export_schemas.py --check",
    "content:stats": "node scripts/py.mjs -m cyberforge content stats",
    "content:readme": "node scripts/py.mjs -m cyberforge content stats --write-readme",
    "content:readme:check": "node scripts/py.mjs -m cyberforge content stats --check-readme",
    "openapi": "node scripts/py.mjs scripts/export_openapi.py",
    "content:mitre": "node scripts/py.mjs scripts/build_mitre_data.py",
    "content:labs": "node scripts/py.mjs scripts/generate_lab_readmes.py",
    "i18n:check": "node scripts/py.mjs scripts/i18n_catalog.py check",
    "i18n:sync": "node scripts/py.mjs scripts/i18n_catalog.py sync",
    "screenshots": "node scripts/screenshots.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml,css}\" --log-level warn",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml,css}\" --log-level warn"
  },
  "devDependencies": {
    "gifenc": "^1.0.3",
    "pngjs": "^7.0.0",
    "prettier": "^3.6.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
