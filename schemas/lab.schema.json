{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by scripts/export_schemas.py. Describes labs/<domain>/<slug>/lab.yaml.",
  "$defs": {
    "Architecture": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 20,
          "title": "Description",
          "type": "string"
        },
        "diagram": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Mermaid diagram source",
          "title": "Diagram"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/Component"
          },
          "minItems": 1,
          "title": "Components",
          "type": "array"
        }
      },
      "required": [
        "description",
        "components"
      ],
      "title": "Architecture",
      "type": "object"
    },
    "AttackSimulation": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 20,
          "title": "Description",
          "type": "string"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/SimulationStep"
          },
          "minItems": 2,
          "title": "Steps",
          "type": "array"
        }
      },
      "required": [
        "description",
        "steps"
      ],
      "title": "AttackSimulation",
      "type": "object"
    },
    "Component": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "network": {
          "default": "lab-internal",
          "enum": [
            "lab-internal",
            "backend",
            "host-localhost",
            "none"
          ],
          "title": "Network",
          "type": "string"
        }
      },
      "required": [
        "name",
        "role"
      ],
      "title": "Component",
      "type": "object"
    },
    "ExpectedDetection": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 20,
          "title": "Description",
          "type": "string"
        },
        "rules": {
          "description": "Slugs of detection rules that must fire",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Rules",
          "type": "array"
        }
      },
      "required": [
        "description",
        "rules"
      ],
      "title": "ExpectedDetection",
      "type": "object"
    },
    "InvestigationQuestion": {
      "additionalProperties": false,
      "properties": {
        "question": {
          "title": "Question",
          "type": "string"
        },
        "hint": {
          "title": "Hint",
          "type": "string"
        },
        "answer": {
          "title": "Answer",
          "type": "string"
        }
      },
      "required": [
        "question",
        "hint",
        "answer"
      ],
      "title": "InvestigationQuestion",
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "minLength": 3,
          "title": "Title",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "title",
        "url"
      ],
      "title": "Reference",
      "type": "object"
    },
    "Safety": {
      "additionalProperties": false,
      "properties": {
        "scope": {
          "default": "simulation-only",
          "enum": [
            "simulation-only",
            "local-container"
          ],
          "title": "Scope",
          "type": "string"
        },
        "network": {
          "default": "none",
          "enum": [
            "none",
            "lab-internal"
          ],
          "title": "Network",
          "type": "string"
        },
        "allowed_targets": {
          "description": "Extra lab hostnames this lab may reference (must end in .lab.internal)",
          "items": {
            "type": "string"
          },
          "title": "Allowed Targets",
          "type": "array"
        }
      },
      "title": "Safety",
      "type": "object"
    },
    "SetupSection": {
      "additionalProperties": false,
      "properties": {
        "requires_containers": {
          "default": false,
          "title": "Requires Containers",
          "type": "boolean"
        },
        "compose_profile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "docker compose profile that starts the lab services",
          "title": "Compose Profile"
        },
        "steps": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        }
      },
      "required": [
        "steps"
      ],
      "title": "SetupSection",
      "type": "object"
    },
    "SimulationStep": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "title": "Title",
          "type": "string"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "title",
        "detail"
      ],
      "title": "SimulationStep",
      "type": "object"
    },
    "TelemetrySection": {
      "additionalProperties": false,
      "properties": {
        "sources": {
          "items": {
            "$ref": "#/$defs/TelemetrySource"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "scenario_file": {
          "default": "telemetry/scenario.jsonl",
          "title": "Scenario File",
          "type": "string"
        }
      },
      "required": [
        "sources"
      ],
      "title": "TelemetrySection",
      "type": "object"
    },
    "TelemetrySource": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "log_source": {
          "description": "Sigma logsource shorthand, e.g. windows/process_creation",
          "title": "Log Source",
          "type": "string"
        }
      },
      "required": [
        "name",
        "description",
        "log_source"
      ],
      "title": "TelemetrySource",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "slug": {
      "maxLength": 96,
      "minLength": 3,
      "title": "Slug",
      "type": "string"
    },
    "number": {
      "maximum": 999,
      "minimum": 1,
      "title": "Number",
      "type": "integer"
    },
    "title": {
      "maxLength": 120,
      "minLength": 3,
      "title": "Title",
      "type": "string"
    },
    "domain": {
      "enum": [
        "web",
        "api",
        "linux",
        "windows-sim",
        "network",
        "cloud",
        "ai-security"
      ],
      "title": "Domain",
      "type": "string"
    },
    "category": {
      "title": "Category",
      "type": "string"
    },
    "difficulty": {
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ],
      "title": "Difficulty",
      "type": "string"
    },
    "duration_minutes": {
      "maximum": 480,
      "minimum": 5,
      "title": "Duration Minutes",
      "type": "integer"
    },
    "summary": {
      "maxLength": 300,
      "minLength": 20,
      "title": "Summary",
      "type": "string"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "objectives": {
      "items": {
        "type": "string"
      },
      "minItems": 2,
      "title": "Objectives",
      "type": "array"
    },
    "architecture": {
      "$ref": "#/$defs/Architecture"
    },
    "scenario": {
      "minLength": 40,
      "title": "Scenario",
      "type": "string"
    },
    "setup": {
      "$ref": "#/$defs/SetupSection"
    },
    "telemetry": {
      "$ref": "#/$defs/TelemetrySection"
    },
    "attack_simulation": {
      "$ref": "#/$defs/AttackSimulation"
    },
    "expected_detection": {
      "$ref": "#/$defs/ExpectedDetection"
    },
    "mitre": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Mitre",
      "type": "array"
    },
    "investigation_questions": {
      "items": {
        "$ref": "#/$defs/InvestigationQuestion"
      },
      "minItems": 2,
      "title": "Investigation Questions",
      "type": "array"
    },
    "mitigation": {
      "items": {
        "type": "string"
      },
      "minItems": 2,
      "title": "Mitigation",
      "type": "array"
    },
    "cleanup": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Cleanup",
      "type": "array"
    },
    "references": {
      "items": {
        "$ref": "#/$defs/Reference"
      },
      "minItems": 1,
      "title": "References",
      "type": "array"
    },
    "safety": {
      "$ref": "#/$defs/Safety"
    }
  },
  "required": [
    "slug",
    "number",
    "title",
    "domain",
    "category",
    "difficulty",
    "duration_minutes",
    "summary",
    "objectives",
    "architecture",
    "scenario",
    "setup",
    "telemetry",
    "attack_simulation",
    "expected_detection",
    "mitre",
    "investigation_questions",
    "mitigation",
    "cleanup",
    "references"
  ],
  "title": "LabDoc",
  "type": "object"
}
